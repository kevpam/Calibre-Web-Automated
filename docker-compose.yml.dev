services:
  calibre-web:
    image: kevpam21/calibre-web-automated:V1
    container_name: calibre-web
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=UTC
      - HARDCOVER_TOKEN=your_hardcover_api_key_here
    volumes:
      # Persistent app config (users, settings, db, etc.)
      - /home/kevin/dev/cwa-config:/config

      # Your Calibre library
      - /home/kevin/dev/calibre-library:/calibre-library

      # Book ingest (files dropped here get auto-imported & deleted after)
      - /home/kevin/dev/cwa-book-ingest:/cwa-book-ingest

      # Calibre plugins (optional)
      - /home/kevin/dev/calibre-plugins:/config/.config/calibre/plugins

      # 🔥 DEV FAST BINDS: mount your local repo directly
      - /home/kevin/dev/Calibre-Web-Automated/cps:/app/calibre-web-automated/cps
      - /home/kevin/dev/Calibre-Web-Automated/templates:/app/calibre-web-automated/templates
      - /home/kevin/dev/Calibre-Web-Automated/scripts:/app/calibre-web-automated/scripts

    ports:
      - 8083:8083
    restart: unless-stopped
